		{
			"name": "Tasks",
			"item": [
				{
					"name": "Create Task (User A)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"pm.test('Task Created 201', function () { pm.response.to.have.status(201); });",
									"pm.environment.set('taskId', jsonData.data._id);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{tokenA}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"User A Critical Task\",\n  \"description\": \"Security ownership check task\",\n  \"status\": \"PENDING\",\n  \"priority\": \"HIGH\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/tasks", "host": ["{{baseUrl}}"], "path": ["api", "tasks"] }
					},
					"response": []
				},
				{
					"name": "Get Tasks (User A)",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{tokenA}}" }],
						"url": { "raw": "{{baseUrl}}/api/tasks?search=Critical&status=PENDING", "host": ["{{baseUrl}}"], "path": ["api", "tasks"], "query": [{ "key": "search", "value": "Critical" }, { "key": "status", "value": "PENDING" }] }
					},
					"response": []
				},
				{
					"name": "CRITICAL ATTACK: User B GET User A Task (Expect 404)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status is 404 Not Found', function () { pm.response.to.have.status(404); });"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{tokenB}}" }],
						"url": { "raw": "{{baseUrl}}/api/tasks/{{taskId}}", "host": ["{{baseUrl}}"], "path": ["api", "tasks", "{{taskId}}"] }
					},
					"response": []
				},
				{
					"name": "CRITICAL ATTACK: User B PATCH User A Task (Expect 404)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status is 404 Not Found', function () { pm.response.to.have.status(404); });"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "PATCH",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{tokenB}}" }
						],
						"body": { "mode": "raw", "raw": "{\n  \"title\": \"Hacked Title\"\n}" },
						"url": { "raw": "{{baseUrl}}/api/tasks/{{taskId}}", "host": ["{{baseUrl}}"], "path": ["api", "tasks", "{{taskId}}"] }
					},
					"response": []
				},
				{
					"name": "CRITICAL ATTACK: User B DELETE User A Task (Expect 404)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status is 404 Not Found', function () { pm.response.to.have.status(404); });"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "DELETE",
						"header": [{ "key": "Authorization", "value": "Bearer {{tokenB}}" }],
						"url": { "raw": "{{baseUrl}}/api/tasks/{{taskId}}", "host": ["{{baseUrl}}"], "path": ["api", "tasks", "{{taskId}}"] }
					},
					"response": []
				}
			]
		}
